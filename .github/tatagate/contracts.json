{
  "schema": 1,
  "repository": "tatachatsdk",
  "workflows": [
    "tatachatsdk.sdk.ci",
    "tatachatsdk.sdk.release"
  ],
  "node_tests": [
    "scripts/build.mjs",
    "scripts/flow.mjs",
    "scripts/release.mjs",
    "scripts/resources.mjs",
    "scripts/ci/index.mjs",
    "scripts/ci/sdk.mjs",
    "scripts/release/index.mjs",
    "scripts/release/sdk.mjs",
    "scripts/target.mjs"
  ],
  "checks": [
    "repository-contracts"
  ],
  "tools": {
    "node": "25.2.1",
    "actionlint": "1.7.12",
    "rust": null
  },
  "platform_forbidden_values": [
    "macOS ARM64",
    "macos-arm64",
    "macos_arm64"
  ],
  "github_repository": "tuyutata/tatachatsdk",
  "functions": [
    {
      "function": "native/src/mls",
      "path": "native/src/mls.rs",
      "runner": "cargo",
      "target": "native/Cargo.toml",
      "package": "tatachat_sdk_native",
      "cases": [
        "corrupt_ciphertext_rejects_without_committing_or_aborting",
        "identity_is_persistent_and_owner_scoped",
        "requests_require_persistent_state_and_reject_unknown_fields",
        "authentication_reuses_persistent_identity_without_mutating_chat_state",
        "authentication_binds_every_field_and_is_separate_from_mls_protocol_labels",
        "authentication_rejects_unsafe_inputs_and_raw_signing_fields",
        "authentication_never_replaces_missing_corrupt_or_wrong_owner_identity",
        "messages_survive_restart_before_host_commit",
        "interrupted_temporary_write_does_not_replace_committed_identity",
        "independent_transactions_are_serialized_and_results_are_not_lost",
        "pending_ciphertext_and_receipts_use_same_owned_snapshot",
        "openmls_smoke_remains_standard",
        "state_file_is_private_and_links_are_rejected",
        "attachment_cursor_archives_chunks_and_deletes_only_owned_protocol_group",
        "attachment_registration_is_closed_scoped_and_bounded",
        "attachment_rejects_noncanonical_registration_and_confirmation_overflow",
        "welcome_rejects_a_valid_mls_signature_with_a_forged_device_credential"
      ]
    },
